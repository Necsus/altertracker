{
  "manifest_version": 3,
  "name": "AlterTracker Collection",
  "version": "1.0",
  "description": "Importe ta collection depuis altered.gg vers altertracker.com",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.altered.gg/*",
    "https://*.altertracker.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "contact@altertracker.com",
      "strict_min_version": "109.0"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Importer collection"
  },
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  }
}